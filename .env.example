# Values below are the production contract passed to the container.
# For local `uv run`, set DJANGO_DEBUG=1. You can then omit DATABASE_URL
# and the container will not be involved; the app keeps using SQLite.

# Unique secret used to sign sessions and CSRF tokens.
# The image refuses to start when DJANGO_DEBUG=0 and this is missing or still
# the development fallback.
DJANGO_SECRET_KEY=change-me

# 0 in production. The image also defaults to 0 when this variable is absent.
DJANGO_DEBUG=0

# Comma-separated hostnames served by this deployment.
# localhost and 127.0.0.1 are always added for the container healthcheck.
DJANGO_ALLOWED_HOSTS=hellotoutous.example

# Full origins allowed to submit forms, including the scheme.
DJANGO_CSRF_TRUSTED_ORIGINS=https://hellotoutous.example

# Set to 1 when TLS is terminated by a reverse proxy in front of the container.
DJANGO_BEHIND_PROXY=1
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1

# Full PostgreSQL URL. Required when DJANGO_DEBUG=0.
# Percent-encode reserved characters in the user or password.
DATABASE_URL=postgres://user:password@host:5432/hellotoutous

# OVH mailbox that sends and receives contact form messages.
# DJANGO_EMAIL_HOST_PASSWORD is the mailbox password from the OVH control panel.
DJANGO_DEFAULT_FROM_EMAIL=hellotoutous@barlords.fr
DJANGO_EMAIL_HOST=ssl0.ovh.net
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=hellotoutous@barlords.fr
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=1

# Public URL of the OVH Object Storage bucket used for article images.
OVH_S3_ENDPOINT_URL=https://hellotoutous-bucket.s3.rbx.io.cloud.ovh.net
# S3 credentials created in the OVH control panel. Leave empty until they exist.
OVH_S3_ACCESS_KEY_ID=
OVH_S3_SECRET_ACCESS_KEY=
